{
  "entities": {
    "User": {
      "title": "User",
      "description": "User progress and currency data",
      "type": "object",
      "properties": {
        "total": {
          "type": "integer",
          "description": "Total trophies"
        },
        "coins": {
          "type": "integer",
          "description": "Coin balance"
        },
        "gems": {
          "type": "integer",
          "description": "Gem balance"
        },
        "powerPoints": {
          "type": "integer",
          "description": "Power points balance"
        },
        "credits": {
          "type": "integer",
          "description": "Credits balance"
        },
        "passXp": {
          "type": "integer",
          "description": "Brawl pass XP"
        },
        "claimedTiers": {
          "type": "array",
          "description": "List of claimed brawl pass tiers"
        },
        "brawlerLevels": {
          "type": "object",
          "description": "Map of brawler key to level"
        },
        "brawlers": {
          "type": "object",
          "description": "Map of brawler key to trophies (or just existence)"
        },
        "unlockingBrawler": {
          "type": "string",
          "description": "Current brawler being unlocked on Starr Road"
        },
        "lastDailyClaim": {
          "type": "integer",
          "description": "Timestamp of last daily reward claim"
        },
        "isLoggedIn": {
          "type": "boolean",
          "description": "Local login status (persisted for consistency)"
        }
      },
      "required": [
        "total",
        "coins",
        "gems",
        "powerPoints",
        "credits",
        "passXp"
      ]
    },
    "Lobby": {
      "title": "Lobby",
      "description": "A waiting room for an online match",
      "type": "object",
      "properties": {
        "hostId": { "type": "string" },
        "players": { "type": "array" },
        "status": { "type": "string", "enum": ["waiting", "ready", "started"] },
        "mode": { "type": "string" },
        "createdAt": { "type": "integer" }
      }
    },
    "OnlineMatch": {
      "title": "Online Match",
      "description": "Active game data",
      "type": "object",
      "properties": {
        "mode": { "type": "string" },
        "startTime": { "type": "integer" },
        "players": { "type": "object" },
        "bullets": { "type": "array" },
        "zones": { "type": "array" },
        "status": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user progress indexed by their authentication UID"
    },
    "/lobbies/{lobbyId}": {
      "schema": "Lobby",
      "description": "Active waiting rooms"
    },
    "/matches/{matchId}": {
      "schema": "OnlineMatch",
      "description": "Live game states"
    },
    "/matches/{matchId}/players/{userId}": {
      "schema": "object",
      "description": "Individual player states in a match"
    }
  }
}
