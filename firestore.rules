rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Validation Blueprints (User Entity)
    function isValidUser(data) {
      return data.keys().hasAll(['total', 'coins', 'gems', 'powerPoints', 'credits', 'passXp', 'claimedTiers', 'brawlerLevels', 'brawlers', 'unlockingBrawler', 'lastDailyClaim', 'isLoggedIn'])
          // Strict Type & Range Checks (Pillar 2 & 7)
          && data.total is int && data.total >= 0
          && data.coins is int && data.coins >= 0
          && data.gems is int && data.gems >= 0
          && data.powerPoints is int && data.powerPoints >= 0
          && data.credits is int && data.credits >= 0
          && data.passXp is int && data.passXp >= 0
          && data.claimedTiers is list && data.claimedTiers.size() <= 1000
          && data.brawlerLevels is map
          && data.brawlers is map
          && (data.unlockingBrawler == null || (data.unlockingBrawler is string && data.unlockingBrawler.size() <= 64))
          && data.lastDailyClaim is int
          && data.isLoggedIn is bool
          // Check key size to prevent shadow fields
          && data.keys().size() == 12;
    }

    function isValidLobby(data) {
      return data.keys().hasAll(['hostId', 'players', 'status', 'mode', 'createdAt'])
          && data.hostId is string
          && data.players is list
          && data.status in ['waiting', 'ready', 'started']
          && data.mode is string
          && data.createdAt is int;
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['mode', 'startTime', 'players', 'bullets', 'zones', 'status'])
          && data.mode is string
          && data.startTime is int
          && data.players is map
          && data.bullets is list
          && data.zones is list
          && data.status is string;
    }

    // --- Collections ---

    match /users/{userId} {
      // 3. Path Variable Hardening
      allow get: if isOwner(userId) && isValidId(userId);
      
      // 8. Secure List Queries (Explicit Deny for listing all users)
      allow list: if false;

      allow create: if isOwner(userId) 
                    && isValidId(userId)
                    && isValidUser(incoming());

      // 4. Action-Based Update Pattern (Simplified for progress syncing)
      allow update: if isOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    // Example action check if we wanted to enforce specific transitions
                    // Here we allow general progress sync but could harden if needed
                    && (incoming().gems >= 0); // Redundant due to isValidUser but good for clarity
    }

    match /lobbies/{lobbyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(lobbyId) && isValidLobby(incoming()) && incoming().hostId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(lobbyId) && isValidLobby(incoming());
      allow delete: if isSignedIn() && (existing().hostId == request.auth.uid || existing().players.size() == 0);
    }

    match /matches/{matchId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidId(matchId); // Broad for now, will refine in code logic if needed
      
      match /players/{playerId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == playerId;
      }
    }
  }
}
